#!/bin/sh
# Secret scan of staged changes. Versioned in .githooks/; enable with:
#   git config core.hooksPath .githooks
# Skips with a warning (exit 0) when gitleaks is missing so CI and bot commits never break.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed, skipping secret scan (brew install gitleaks)" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
