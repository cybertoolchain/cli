#!/bin/sh
# secret-scan hook: gitleaks over the staged changes. Source of truth is .githooks/pre-commit;
# `sh .githooks/install.sh` COPIES it to .git/hooks/ so a checked-out branch cannot change what runs.
# Fails closed: a leak, a gitleaks crash, or a missing binary all block the commit.
# (`git commit --no-verify` still bypasses any local hook; the CI scan is the enforcing control.)
GL=$(command -v gitleaks 2>/dev/null)
if [ -z "$GL" ]; then
  for p in /opt/homebrew/bin/gitleaks /usr/local/bin/gitleaks; do
    if [ -x "$p" ]; then GL=$p; break; fi
  done
fi
if [ -z "$GL" ]; then
  echo "pre-commit: gitleaks not found - run 'brew install gitleaks', or commit with --no-verify deliberately" >&2
  exit 1
fi
"$GL" git --pre-commit --staged --redact --no-banner || {
  echo "pre-commit: gitleaks reported a leak or failed - commit blocked (fix it, or commit with --no-verify deliberately)" >&2
  exit 1
}
